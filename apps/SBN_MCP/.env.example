# ============================================================
# Variables de Entorno — Sistema de Gestión de Bienes Nacionales
# Copiar este archivo como .env y completar los valores
# ============================================================

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hospital_bienes
DB_USER=root
DB_PASS=admin

# Aplicación
APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=America/Caracas
APP_URL=/MCP/apps/SBN_MCP/public
# Generate a secure key: openssl rand -base64 32
APP_KEY=CHANGE_THIS_TO_SECURE_RANDOM_KEY_32_CHARS

# Seguridad
SESSION_LIFETIME=30
CSRF_TOKEN_LIFETIME=3600
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900

# Correo de contacto
MAIL_CONTACTO=dtsr32361670@gmail.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=dtsr32361670@gmail.com
MAIL_PASSWORD=
MAIL_FROM=dtsr32361670@gmail.com
MAIL_FROM_NAME=Sistema Bienes Nacionales MCP
MAIL_ENCRYPTION=tls

# File upload limits
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,webp

# Rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=3600
